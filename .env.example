# Bu dosyayı ".env.local" adıyla kopyala ve değerleri Supabase panelinden doldur.
# Supabase → Project Settings → API
#
# NOT: anon key public olacak şekilde tasarlanmıştır, gizli değildir.
# Yetkilendirmeyi Row Level Security (supabase/schema.sql) sağlar.
# service_role key'ini ASLA buraya veya frontend'e koyma.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
